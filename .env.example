# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.mmourouh.dev
GA_TRACKING_ID=

# --- Admin login (GitHub OAuth App) ---
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL:  https://www.mmourouh.dev
#   Callback URL:  https://www.mmourouh.dev/api/auth/callback/github
# (create a second OAuth App for local dev with http://localhost:3000/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=

# Random secret for signing sessions: run `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Public URL of the site (http://localhost:3000 locally)
NEXTAUTH_URL=https://www.mmourouh.dev

# Only these GitHub account ids may sign in (comma separated). m-mourouh = 60442896
ADMIN_GITHUB_ID=60442896

# --- Saving content (fine-grained personal access token) ---
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   Repository access: Only select repositories → m-mourouh/Portfolio
#   Permissions → Repository → Contents: Read and write   (nothing else)
GITHUB_CONTENT_TOKEN=
GITHUB_REPO=m-mourouh/Portfolio
# Branch Vercel deploys to production from
GITHUB_BRANCH=main
